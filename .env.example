DISCORD_API_TOKEN="token"
CLIENT_ID=""
WEBSOCKET_API_URL="http://localhost:8000"

# Guild to deploy slash commands to. Guild commands apply instantly, which is
# what you want while iterating. Leave empty to deploy globally instead — that
# reaches every server the bot is in, but can take up to an hour to propagate.
DISCORD_GUILD_ID=""

# Shared secret for the /discord/commands routes. Required: with no value set
# those routes reject every request.
ADMIN_TOKEN=""